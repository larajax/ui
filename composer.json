{
    "name": "larajax/ui",
    "description": "Form, List and UI tools",
    "homepage": "https://github.com/larajax/ui",
    "require": {
        "php": "^8.2",
        "larajax/larajax": "^3.0",
        "league/csv": "^9.27",
        "octoberrain/contracts": "5.x-dev",
        "octoberrain/exception": "5.x-dev",
        "octoberrain/extension": "5.x-dev",
        "octoberrain/html": "5.x-dev",
        "symfony/yaml": "^6.4|^7.0"
    },
    "suggest": {
        "october/rain": "Rain models add file attachments, trees, sorting, deferred bindings and model validation"
    },
    "autoload": {
        "psr-4": {
            "Larajax\\Ui\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larajax\\Ui\\UiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
