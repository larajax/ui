{
    "name": "larajax/ui",
    "description": "Form, List and UI tools",
    "homepage": "https://github.com/larajax/ui",
    "require": {
        "php": "^8.2",
        "october/rain": "dev-next as 4.4.0"
    },
    "autoload": {
        "psr-4": {
            "Larajax\\Ui\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larajax\\Ui\\UiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
